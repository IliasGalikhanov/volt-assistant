{
  "openapi": "3.1.0",
  "info": {
    "title": "Volt Assistant API",
    "version": "0.1.0",
    "description": "Local cookie session API. GET /datasets establishes a session. Dataset defaults to demo. All mutations require X-Volt-Request: 1 and a matching Origin when supplied. No real orders or payments."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Database readiness",
        "operationId": "get_api_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error: 400 validation, 403 ownership/CSRF, 409 stale proposal, 422 business rule, 429 upload limit, 500/502/503 unavailable dependency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/datasets": {
      "get": {
        "summary": "List session-owned and synthetic datasets",
        "operationId": "get_api_datasets",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Dataset"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error: 400 validation, 403 ownership/CSRF, 409 stale proposal, 422 business rule, 429 upload limit, 500/502/503 unavailable dependency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
