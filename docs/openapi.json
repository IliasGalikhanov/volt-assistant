    "/api/uploads": {
      "post": {
        "summary": "Enqueue an upload up to 10 MiB",
        "operationId": "post_api_uploads",
        "parameters": [
          {
            "name": "dataset",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "demo"
            }
          },
          {
            "name": "X-Volt-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
