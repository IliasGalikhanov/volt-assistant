              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cart/proposals": {
      "post": {
        "summary": "Quote complete future cart; does not mutate cart",
        "operationId": "post_api_cart_proposals",
        "parameters": [
          {
            "name": "dataset",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "demo"
            }
          },
          {
            "name": "X-Volt-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proposal"
                }
              }
            }
          },
          "default": {
            "description": "Error: 400 validation, 403 ownership/CSRF, 409 stale proposal, 422 business rule, 429 upload limit, 500/502/503 unavailable dependency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Selection"
                    }
                  },
                  "replace": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "items"
                ]
              }
            }
          }
        }
      }
    },
    "/api/cart/proposals/{id}/confirm": {
      "post": {
        "summary": "Confirm proposal transactionally and idempotently",
        "operationId": "post_api_cart_proposals_id_confirm",
