                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Grounded model-assisted or deterministic catalogue search",
        "operationId": "post_api_chat",
        "parameters": [
          {
            "name": "dataset",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "demo"
            }
          },
          {
            "name": "X-Volt-Request",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          },
          "default": {
            "description": "Error: 400 validation, 403 ownership/CSRF, 409 stale proposal, 422 business rule, 429 upload limit, 500/502/503 unavailable dependency",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "ru",
                      "kk",
                      "en"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "fallback",
                      "off"
                    ]
                  }
                },
                "required": [
                  "text",
                  "mode"
                ]
              }
            }
          }
        }
      }
    },
