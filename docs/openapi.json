          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "catalogue",
                      "specification"
                    ]
                  },
                  "mapping": {
                    "type": "string",
                    "description": "JSON map of canonical field to file header"
                  },
                  "model_mode": {
                    "type": "string",
                    "enum": [
                      "primary",
                      "fallback",
                      "off"
                    ]
                  }
                },
                "required": [
                  "file",
                  "kind"
                ]
              }
            }
          }
        }
      }
    },
