            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirmed": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "confirmed"
                ]
              }
            }
          }
        }
      }
    },
    "/api/cart/export": {
      "get": {
        "summary": "Download current cart as CSV or XLSX",
