          {
            "name": "dataset",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "demo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Error: 400 validation, 403 ownership/CSRF, 409 stale proposal, 422 business rule, 429 upload limit, 500/502/503 unavailable dependency",
